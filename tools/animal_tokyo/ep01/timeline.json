  "subs": [
    { "start": 0.4,  "end": 2.6,  "text": "人がまだ寝ている時間、\n渋谷ではもう朝ごはんが始まる" },
    { "start": 2.75, "end": 4.9,  "text": "明治神宮の森。\n夜のあいだ、人は入れない" },
    { "start": 5.3,  "end": 9.8,  "text": "日の出の30分以上前。\nカラスはもう起きている" },
    { "start": 10.3, "end": 14.8, "text": "狙うのは、人が出した生ごみ" },
    { "start": 15.3, "end": 19.8, "text": "袋の外から中身が見えると、\n見逃さない" },
    { "start": 20.3, "end": 24.8, "text": "ごみが片づく前に、\n朝ごはんは終わる" },
    { "start": 25.3, "end": 29.8, "text": "夕方、また森へ帰っていく" },
    { "start": 30.6, "end": 33.9, "text": "眠るのは森、食べるのは街" },
    { "start": 34.1, "end": 37.8, "text": "東京のカラスは、\nこの20年あまりで約8割減った" }
  ]
}
