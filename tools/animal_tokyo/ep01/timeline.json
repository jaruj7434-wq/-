  "subs": [
    {
      "start": 0.4,
      "end": 2.6,
      "text": "今日の主役は、\n東京のハシブトガラス"
    },
    {
      "start": 2.75,
      "end": 4.9,
      "text": "夜明け前の森で目をさます"
    },
    {
      "start": 5.3,
      "end": 8.7,
      "text": "見分けるポイントは、\nくちばしと おでこ"
    },
    {
      "start": 8.9,
      "end": 9.9,
      "text": "ここからは、カラスの目線で"
    },
    {
      "start": 10.3,
      "end": 13.8,
      "text": "明治神宮の森。\n夜のあいだ、人は入れない"
    },
    {
      "start": 14.3,
      "end": 18.8,
      "text": "日の出の30分以上前。\nカラスはもう起きている"
    },
    {
      "start": 19.3,
      "end": 23.8,
      "text": "狙うのは、人が出した生ごみ"
    },
    {
      "start": 24.3,
      "end": 28.8,
      "text": "袋の外から中身が見えると、\n見逃さない"
    },
    {
      "start": 29.3,
      "end": 33.8,
      "text": "ごみが片づく前に、\n朝ごはんは終わる"
    },
    {
      "start": 34.3,
      "end": 36.9,
      "text": "食べきれない分は、\n土の中にかくしておく"
    },
    {
      "start": 37.0,
      "end": 39.8,
      "text": "上から落ち葉をかぶせて、\nあとで食べるためにとっておく"
    },
    {
      "start": 40.3,
      "end": 45.8,
      "text": "公園の池で、水浴び"
    },
    {
      "start": 46.3,
      "end": 48.9,
      "text": "昼間は、緑地でひと休み"
    },
    {
      "start": 49.0,
      "end": 51.8,
      "text": "森は寝床であり、\n昼の休憩所でもある"
    },
    {
      "start": 52.3,
      "end": 57.8,
      "text": "カラスは、人の顔を\n見分けているらしい"
    },
    {
      "start": 58.3,
      "end": 63.8,
      "text": "高い場所から、\n次のエサ場をさがす"
    },
    {
      "start": 64.3,
      "end": 69.8,
      "text": "ねぐらに入る前、\n仲間といったん集まる"
    },
    {
      "start": 70.3,
      "end": 74.8,
      "text": "夕方、また森へ帰っていく"
    },
    {
      "start": 75.3,
      "end": 77.9,
      "text": "羽をふくらませて、\nおやすみ"
    },
    {
      "start": 78.0,
      "end": 80.8,
      "text": "カラスも野生の鳥。\n法律で守られている"
    },
    {
      "start": 81.6,
      "end": 84.9,
      "text": "眠るのは森、食べるのは街"
    },
    {
      "start": 85.1,
      "end": 88.8,
      "text": "東京のカラスは、\nこの20年あまりで約8割減った"
    }
  ],
  "tips": [
    {
      "start": 6.2,
      "end": 8.7,
      "text": "ハシブトガラス：全長約56cm\n鳴き声は澄んだ「カァ」\n濁った「ガー」はハシボソガラス",
      "src": "Canon 野鳥写真図鑑",
      "y": 150
    },
    {
      "start": 20.0,
      "end": 23.8,
      "text": "一度エサがあった場所は、\nくり返し狙う",
      "src": "宇都宮市 カラス対策"
    },
    {
      "start": 24.6,
      "end": 27.2,
      "text": "ハシブトは両足をそろえて\nピョンピョン跳ねる\n（ハシボソは交互に歩く）",
      "src": "Canon 野鳥写真図鑑"
    },
    {
      "start": 35.0,
      "end": 39.6,
      "text": "エサを隠す「貯食」は、\n都市のカラスでも観察されている",
      "src": "日本野鳥の会 Strix"
    },
    {
      "start": 54.0,
      "end": 57.8,
      "text": "アメリカのカラスの研究：\nこわいことをした人の顔を覚え、\n仲間にも伝えた",
      "src": "AFP（ワシントン大学の研究）"
    },
    {
      "start": 59.2,
      "end": 63.6,
      "text": "色を少なくとも1年は\n覚えていたという実験も",
      "src": "東洋経済（宇都宮大学 杉田名誉教授ら）"
    },
    {
      "start": 65.2,
      "end": 69.6,
      "text": "集まる場所は、\nねぐらとは別のことが多い",
      "src": "日本鳥学会誌 53巻2号"
    },
    {
      "start": 70.8,
      "end": 74.6,
      "text": "春〜初夏（3〜7月）の繁殖期は、\n巣の半径20〜100mが縄張り",
      "src": "中央区"
    },
    {
      "start": 78.2,
      "end": 80.8,
      "text": "許可なく捕まえることは\n鳥獣保護管理法で禁止",
      "src": "江戸川区",
      "y": 700
    }
  ]
}