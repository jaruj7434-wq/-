  "subs": [
    {
      "start": 0.4,
      "end": 2.6,
      "text": "人がまだ寝ている時間、\n渋谷ではもう朝ごはんが始まる"
    },
    {
      "start": 2.75,
      "end": 4.9,
      "text": "明治神宮の森。\n夜のあいだ、人は入れない"
    },
    {
      "start": 5.3,
      "end": 9.8,
      "text": "日の出の30分以上前。\nカラスはもう起きている"
    },
    {
      "start": 10.3,
      "end": 14.8,
      "text": "狙うのは、人が出した生ごみ"
    },
    {
      "start": 15.3,
      "end": 19.8,
      "text": "袋の外から中身が見えると、\n見逃さない"
    },
    {
      "start": 20.3,
      "end": 24.8,
      "text": "ごみが片づく前に、\n朝ごはんは終わる"
    },
    {
      "start": 25.3,
      "end": 27.9,
      "text": "食べきれない分は、\n土の中にかくしておく"
    },
    {
      "start": 28.0,
      "end": 30.8,
      "text": "上から落ち葉をかぶせて、\nあとで食べるためにとっておく"
    },
    {
      "start": 31.3,
      "end": 36.8,
      "text": "公園の池で、水浴び"
    },
    {
      "start": 37.3,
      "end": 39.9,
      "text": "昼間は、緑地でひと休み"
    },
    {
      "start": 40.0,
      "end": 42.8,
      "text": "森は寝床であり、\n昼の休憩所でもある"
    },
    {
      "start": 43.3,
      "end": 48.8,
      "text": "高い場所から、\n次のエサ場をさがす"
    },
    {
      "start": 49.3,
      "end": 54.8,
      "text": "ねぐらに入る前、\n仲間といったん集まる"
    },
    {
      "start": 55.3,
      "end": 59.8,
      "text": "夕方、また森へ帰っていく"
    },
    {
      "start": 60.6,
      "end": 63.9,
      "text": "眠るのは森、食べるのは街"
    },
    {
      "start": 64.1,
      "end": 67.8,
      "text": "東京のカラスは、\nこの20年あまりで約8割減った"
    }
  ]
}